        label='Подать заявку', emoji=MEMBER,
        style=discord.ButtonStyle.success, custom_id='wl_panel:apply',
    )
    async def apply(self, interaction: discord.Interaction, button: discord.ui.Button):
        await _start_application(interaction)


async def _start_application(interaction: discord.Interaction):
    bot = interaction.client
    guild_id = interaction.guild_id
    user = interaction.user

    # 1. Уже одобрен?
    row = await _fetchone(
        bot,
        "SELECT status FROM whitelist_apps WHERE guild_id = ? AND user_id = ? "
        "AND status IN ('approved', 'completed') LIMIT 1",
        (guild_id, user.id),
    )
    if row:
        await interaction.response.send_message(
            embed=info('Ты уже в белом списке 💚 Если возникли проблемы со входом — создай тикет.'),
            ephemeral=True,
        )
        return

    # 2. Уже есть заявка на рассмотрении?
    row = await _fetchone(
        bot,
        "SELECT id FROM whitelist_apps WHERE guild_id = ? AND user_id = ? AND status = 'pending' LIMIT 1",
        (guild_id, user.id),
    )
    if row:
        await interaction.response.send_message(
            embed=info('Твоя заявка уже на рассмотрении. Ответ придёт в личные сообщения ⏳'),
            ephemeral=True,
        )
        return

    # 3. Кулдаун после отказа
    row = await _fetchone(
        bot,
        "SELECT reviewed_at FROM whitelist_apps WHERE guild_id = ? AND user_id = ? "
        "AND status = 'denied' ORDER BY id DESC LIMIT 1",
        (guild_id, user.id),
    )
    if row and _row(row, 'reviewed_at'):
        try:
            reviewed = datetime.fromisoformat(str(_row(row, 'reviewed_at')).replace('Z', ''))
            if reviewed.tzinfo is None:
                reviewed = reviewed.replace(tzinfo=timezone.utc)
            unlock = reviewed + timedelta(hours=DENY_COOLDOWN_HOURS)
            if datetime.now(timezone.utc) < unlock:
                await interaction.response.send_message(
                    embed=warn(
                        f'Твою прошлую заявку отклонили. Подать новую можно '
                        f'<t:{int(unlock.timestamp())}:R> (<t:{int(unlock.timestamp())}:f>).'
                    ),
                    ephemeral=True,
                )
                return
        except Exception:
            pass

    await interaction.response.send_modal(ApplicationModal())


