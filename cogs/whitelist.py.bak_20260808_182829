class ApplicationModal(discord.ui.Modal, title='Заявка в белый список'):
    nick = discord.ui.TextInput(
        label='Ник в Minecraft', placeholder='Например: Amioka',
        min_length=3, max_length=16, required=True,
    )
    age = discord.ui.TextInput(
        label='Сколько тебе лет?', placeholder='Например: 17',
        min_length=1, max_length=3, required=True,
    )
    reason = discord.ui.TextInput(
        label='Почему хочешь к нам?', style=discord.TextStyle.paragraph,
        min_length=20, max_length=600, required=True,
    )
    about = discord.ui.TextInput(
        label='Расскажи немного о себе', style=discord.TextStyle.paragraph,
        min_length=10, max_length=600, required=True,
    )
    invited_by = discord.ui.TextInput(
        label='Кто пригласил? (необязательно)', required=False, max_length=100,
    )

    async def on_submit(self, interaction: discord.Interaction):
        nick = str(self.nick).strip()
        age_raw = str(self.age).strip()

        if not NICK_RE.match(nick):
            await interaction.response.send_message(
                embed=err('Ник может содержать только латинские буквы, цифры и `_`, длина 3–16 символов.'),
                ephemeral=True,
            )
            return
        if not age_raw.isdigit() or not (5 <= int(age_raw) <= 99):
            await interaction.response.send_message(
                embed=err('Возраст нужно указать числом (например `17`).'), ephemeral=True,
            )
            return

        await interaction.response.defer(ephemeral=True, thinking=True)
        await _create_application(
            interaction,
            nick=nick,
            age=age_raw,
            reason=str(self.reason).strip(),
            about=str(self.about).strip(),
            invited_by=(str(self.invited_by).strip() or 'никто'),
        )


async def _create_application(interaction, nick, age, reason, about, invited_by):
    bot = interaction.client
    guild = interaction.guild
    user = interaction.user
    s = await _settings(bot, guild.id)

    # Ник уже занят другой заявкой?
    busy = await _fetchone(
        bot,
        "SELECT user_id FROM whitelist_apps WHERE guild_id = ? AND LOWER(minecraft_nick) = LOWER(?) "
        "AND status IN ('pending', 'approved', 'completed') LIMIT 1",
        (guild.id, nick),
    )
    if busy and int(_row(busy, 'user_id', 0)) != user.id:
        await interaction.followup.send(
            embed=err(f'Ник `{nick}` уже используется другим участником. Укажи свой настоящий ник.'),
            ephemeral=True,
        )
        return

    category = None
    cat_id = _row(s, 'wl_category_id') or _row(s, 'tech_ticket_category_id')
    if cat_id:
        category = guild.get_channel(int(cat_id))

    # Права: заявку видят только админы и бот, сам игрок — НЕТ
    overwrites = {
        guild.default_role: discord.PermissionOverwrite(view_channel=False),
        user: discord.PermissionOverwrite(view_channel=False),
        guild.me: discord.PermissionOverwrite(
            view_channel=True, send_messages=True, manage_channels=True, embed_links=True
        ),
    }
    for role in guild.roles:
        if role.permissions.manage_guild or role.permissions.administrator:
            overwrites[role] = discord.PermissionOverwrite(
                view_channel=True, send_messages=True, read_message_history=True
            )

    safe_name = re.sub(r'[^a-z0-9_-]', '', user.name.lower())[:16] or str(user.id)[:16]
    try:
        channel = await guild.create_text_channel(
            name=f'wl-app-{safe_name}',
            category=category,
            overwrites=overwrites,
            topic=f'Заявка в белый список • {user} • ник: {nick}',
            reason=f'Whitelist application from {user}',
        )
    except discord.Forbidden:
        await interaction.followup.send(
            embed=err('Боту не хватает прав «Управлять каналами», чтобы создать заявку. Сообщи администрации.'),
            ephemeral=True,
        )
        return
    except Exception as e:
        logger.error(f'Cannot create application channel: {e}')
        await interaction.followup.send(
            embed=err('Не удалось создать заявку. Попробуй позже или создай тикет.'), ephemeral=True,
        )
        return

    app_id = await _exec(
        bot,
        "INSERT INTO whitelist_apps "
        "(guild_id, user_id, ticket_channel_id, minecraft_nick, join_reason, about_me, age, "
        " invited_by, status, created_at) "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?)",
        (guild.id, user.id, channel.id, nick, reason, about, age, invited_by,
         datetime.now(timezone.utc).isoformat()),
    )

    mojang_status, skin_url = await _mojang_lookup(nick)

    created = user.created_at
    account_days = (datetime.now(timezone.utc) - created).days
    account_info = f'<t:{int(created.timestamp())}:R>'
    if account_days < NEW_ACCOUNT_DAYS:
        account_info += f'\n⚠️ аккаунт младше {NEW_ACCOUNT_DAYS} дней'

    embed = wl_app_embed(
        user, nick, reason, about, age, invited_by,
        mojang_status=mojang_status, account_info=account_info, skin_url=skin_url,
    )
    embed.set_footer(text=f'Fluffy Vanilla • Заявка #{app_id}')

    msg = await channel.send(embed=embed, view=WhitelistReviewView())
    try:
        await msg.pin()
    except Exception:
        pass

    notify_id = _row(s, 'wl_notify_channel_id')
    if notify_id:
        notify = guild.get_channel(int(notify_id))
        if notify:
            try:
                await notify.send(
                    embed=info(
                        f'Новая заявка в белый список от {user.mention} (ник `{nick}`)\n'
                        f'Канал заявки: {channel.mention}',
                        title='📝 Новая заявка',
                    )
                )
            except Exception:
                pass

    await interaction.followup.send(
        embed=ok(
            'Заявка отправлена! ✨\n\n'
            'Она **на рассмотрении** у администрации. Решение придёт тебе в личные сообщения — '
            'убедись, что ЛС от участников сервера у тебя открыты.',
            title='Заявка принята',
        ),
        ephemeral=True,
    )
    logger.info(f'WL application #{app_id} submitted by {user} (nick: {nick})')


