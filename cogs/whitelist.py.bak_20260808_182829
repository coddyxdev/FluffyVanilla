class Whitelist(commands.Cog):
    wl = app_commands.Group(
        name='whitelist',
        description='Управление белым списком',
        guild_only=True,
        default_permissions=discord.Permissions(manage_guild=True),
    )

    def __init__(self, bot):
        self.bot = bot

    async def cog_load(self):
        await self.bot.db.db.executescript(
            '''
            CREATE TABLE IF NOT EXISTS wl_mc_queue (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                guild_id INTEGER NOT NULL,
                user_id INTEGER NOT NULL,
                nick TEXT NOT NULL,
                attempts INTEGER DEFAULT 0,
                created_at TEXT
            );
            CREATE TABLE IF NOT EXISTS wl_panels (
                guild_id INTEGER NOT NULL,
                channel_id INTEGER NOT NULL,
                message_id INTEGER NOT NULL,
                PRIMARY KEY (guild_id, channel_id)
            );
            '''
        )
        await self.bot.db.db.commit()
        self._queue_worker.start()

    def cog_unload(self):
        self._queue_worker.cancel()

    # ── Фоновая выдача вайтлиста, если сервер был недоступен ────────────────

    @tasks.loop(minutes=5)
    async def _queue_worker(self):
        try:
            rows = await _fetchall(
                self.bot, 'SELECT * FROM wl_mc_queue WHERE attempts < ? ORDER BY id LIMIT 25',
                (MAX_QUEUE_ATTEMPTS,),
            )
        except Exception:
            return
        for row in rows:
            guild = self.bot.get_guild(int(_row(row, 'guild_id', 0)))
            if not guild:
                continue
            s = await _settings(self.bot, guild.id)
            success, _ = await _mc_whitelist_add(s, str(_row(row, 'nick', '')))
            if success:
                await _exec(self.bot, 'DELETE FROM wl_mc_queue WHERE id = ?', (_row(row, 'id'),))
                member = guild.get_member(int(_row(row, 'user_id', 0)))
                if member:
                    await _dm(member, discord.Embed(
                        title='✅ Ты добавлен на игровой сервер',
                        description=f'Ник `{_row(row, "nick")}` добавлен в вайтлист. Заходи играть 💚',
                        color=SUCCESS,
                    ))
            else:
                await _exec(
                    self.bot, 'UPDATE wl_mc_queue SET attempts = attempts + 1 WHERE id = ?',
                    (_row(row, 'id'),),
                )

    @_queue_worker.before_loop
    async def _before_queue(self):
        await self.bot.wait_until_ready()

    # ── /whitelist panel ────────────────────────────────────────────────────

    @wl.command(name='panel', description='Отправить кнопку «Подать заявку» в выбранный канал')
    @app_commands.describe(channel='Канал для кнопки (по умолчанию — текущий)')
    async def panel(self, interaction: discord.Interaction, channel: discord.TextChannel = None):
        target = channel or interaction.channel
        await interaction.response.defer(ephemeral=True)

        # Удаляем старую панель в этом канале, чтобы не плодить дубли
        old = await _fetchone(
            self.bot, 'SELECT message_id FROM wl_panels WHERE guild_id = ? AND channel_id = ?',
            (interaction.guild_id, target.id),
        )
        if old:
            try:
                old_msg = await target.fetch_message(int(_row(old, 'message_id', 0)))
                await old_msg.delete()
            except Exception:
                pass

        try:
            msg = await target.send(view=WhitelistPanelView())
        except discord.Forbidden:
            await interaction.followup.send(
                embed=err(f'Нет прав писать в {target.mention}. Дай боту «Отправлять сообщения».'),
                ephemeral=True,
            )
            return
        except discord.HTTPException:
            msg = await target.send(content='\u200b', view=WhitelistPanelView())

        await _exec(
            self.bot,
            'INSERT OR REPLACE INTO wl_panels (guild_id, channel_id, message_id) VALUES (?, ?, ?)',
            (interaction.guild_id, target.id, msg.id),
        )
        await self.bot.db.set(interaction.guild_id, wl_info_channel_id=target.id)
        await interaction.followup.send(
            embed=ok(f'Кнопка подачи заявки отправлена в {target.mention}.'), ephemeral=True,
        )

    @wl.command(name='post_info', description='Отправить информационный embed о белом списке')
    @app_commands.describe(channel='Канал (по умолчанию — текущий)')
    async def post_info(self, interaction: discord.Interaction, channel: discord.TextChannel = None):
        target = channel or interaction.channel
        await target.send(embed=wl_info_embed())
        await interaction.response.send_message(
            embed=ok(f'Информация отправлена в {target.mention}.'), ephemeral=True,
        )

    # ── Ручное одобрение / отказ ────────────────────────────────────────────

    @wl.command(name='approve', description='Одобрить заявку вручную (в канале заявки)')
    async def approve_cmd(self, interaction: discord.Interaction):
        app = await _get_app_by_channel(self.bot, interaction.channel_id)
        if not app or _row(app, 'status') != 'pending':
            await interaction.response.send_message(
                embed=err('Активной заявки в этом канале нет. Используй команду внутри канала заявки.'),
                ephemeral=True,
            )
            return
        await interaction.response.defer()
        await _finish_approve(interaction, app, interaction.user)

    @wl.command(name='deny', description='Отклонить заявку вручную с причиной (в канале заявки)')
    @app_commands.describe(reason='Причина отказа — её увидит игрок')
    async def deny_cmd(self, interaction: discord.Interaction, reason: str):
        app = await _get_app_by_channel(self.bot, interaction.channel_id)
        if not app or _row(app, 'status') != 'pending':
            await interaction.response.send_message(
                embed=err('Активной заявки в этом канале нет. Используй команду внутри канала заявки.'),
                ephemeral=True,
            )
            return
        await interaction.response.defer()
        await _finish_deny(interaction, app, interaction.user, reason)

    # ── Управление участниками ──────────────────────────────────────────────

    @wl.command(name='revoke', description='Забрать белый список у участника')
    @app_commands.describe(member='Участник', reason='Причина (увидит игрок в ЛС)')
    async def revoke(self, interaction: discord.Interaction, member: discord.Member, reason: str = 'не указана'):
        await interaction.response.defer(ephemeral=True)
        s = await _settings(self.bot, interaction.guild_id)
        app = await _fetchone(
            self.bot,
            "SELECT minecraft_nick FROM whitelist_apps "
            "WHERE guild_id = ? AND user_id = ? AND status IN ('approved', 'completed') "
            "ORDER BY id DESC LIMIT 1",
            (interaction.guild_id, member.id),
        )
        nick = str(_row(app, 'minecraft_nick', '')).strip() if app else ''
        role_id = _row(s, 'wl_role_id')
        if role_id:
            role = interaction.guild.get_role(int(role_id))
            if role and role in member.roles:
                try:
                    await member.remove_roles(role, reason=f'Whitelist revoked by {interaction.user}: {reason}')
                except Exception:
                    pass
        mc_ok, mc_note = await _mc_whitelist_remove(s, nick)
        await _exec(
            self.bot,
            "UPDATE whitelist_apps SET status = 'denied', reviewed_by = ?, reviewed_at = ? "
            "WHERE guild_id = ? AND user_id = ? AND status IN ('approved', 'completed')",
            (interaction.user.id, datetime.now(timezone.utc).isoformat(), interaction.guild_id, member.id),
        )
        await _dm(member, discord.Embed(
            title='Доступ к серверу отозван',
            description=f'Твой белый список на **Fluffy Vanilla** отозван.\n**Причина:** {reason}',
            color=ERROR,
        ))
        if mc_ok:
            await interaction.followup.send(
                embed=ok(f'Whitelist отозван у {member.mention}; Minecraft-ник `{nick}` удалён с сервера.'),
                ephemeral=True,
            )
        else:
            await interaction.followup.send(
                embed=warn(f'Роль и статус отозваны, но Minecraft whitelist не обновлён.\n{mc_note}'),
                ephemeral=True,
            )

    @wl.command(name='reset', description='Сбросить историю заявок участника (сможет подать заново сразу)')
    @app_commands.describe(member='Участник')
    async def reset(self, interaction: discord.Interaction, member: discord.Member):
        await _exec(
            self.bot, 'DELETE FROM whitelist_apps WHERE guild_id = ? AND user_id = ?',
            (interaction.guild_id, member.id),
        )
        await interaction.response.send_message(
            embed=ok(f'История заявок {member.mention} очищена — теперь можно подать новую заявку.'),
            ephemeral=True,
        )

    @wl.command(name='status', description='Показать статус заявки участника')
    @app_commands.describe(member='Участник')
    async def status(self, interaction: discord.Interaction, member: discord.Member):
        app = await _fetchone(
            self.bot,
            'SELECT * FROM whitelist_apps WHERE guild_id = ? AND user_id = ? ORDER BY id DESC LIMIT 1',
            (interaction.guild_id, member.id),
        )
        if not app:
            await interaction.response.send_message(
                embed=info(f'{member.mention} ещё не подавал(а) заявку.'), ephemeral=True,
            )
            return
        labels = {
            'pending': '⏳ на рассмотрении',
            'approved': '✅ одобрена',
            'completed': '✅ одобрена',
            'denied': '❌ отклонена',
        }
        e = discord.Embed(title=f'Заявка #{_row(app, "id")}', color=PINK)
        e.add_field(name='Игрок', value=member.mention, inline=True)
        e.add_field(name='Ник', value=str(_row(app, 'minecraft_nick', '—')), inline=True)
        e.add_field(name='Статус', value=labels.get(str(_row(app, 'status')), str(_row(app, 'status'))), inline=True)
        e.add_field(name='Подана', value=str(_row(app, 'created_at', '—'))[:19], inline=True)
        if _row(app, 'reviewed_by'):
            e.add_field(name='Рассмотрел', value=f'<@{_row(app, "reviewed_by")}>', inline=True)
        await interaction.response.send_message(embed=e, ephemeral=True)

    # ── Статистика и синхронизация ──────────────────────────────────────────

    @wl.command(name='stats', description='Статистика по заявкам белого списка')
    async def stats(self, interaction: discord.Interaction):
        rows = await _fetchall(
            self.bot,
            'SELECT status, COUNT(*) AS cnt FROM whitelist_apps WHERE guild_id = ? GROUP BY status',
            (interaction.guild_id,),
        )
        counts = {str(_row(r, 'status')): int(_row(r, 'cnt', 0)) for r in rows}
        approved = counts.get('approved', 0) + counts.get('completed', 0)
        pending = counts.get('pending', 0)
        denied = counts.get('denied', 0)
        total = approved + pending + denied

        queued = await _fetchone(
            self.bot, 'SELECT COUNT(*) AS cnt FROM wl_mc_queue WHERE guild_id = ?',
            (interaction.guild_id,),
        )
        in_queue = int(_row(queued, 'cnt', 0))

        rate = f'{approved / total * 100:.0f}%' if total else '—'
        e = discord.Embed(title='📊 Статистика белого списка', color=PINK)
        e.add_field(name='Всего заявок', value=str(total), inline=True)
        e.add_field(name='Одобрено', value=str(approved), inline=True)
        e.add_field(name='Отклонено', value=str(denied), inline=True)
        e.add_field(name='На рассмотрении', value=str(pending), inline=True)
        e.add_field(name='Процент одобрений', value=rate, inline=True)
        e.add_field(name='Ждут выдачи на MC-сервере', value=str(in_queue), inline=True)
        e.set_footer(text='Fluffy Vanilla')
        await interaction.response.send_message(embed=e, ephemeral=True)

    @wl.command(name='sync', description='Перезалить все одобренные ники в вайтлист Minecraft-сервера')
    async def sync(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        s = await _settings(self.bot, interaction.guild_id)
        if not (_row(s, 'mc_host') and _row(s, 'mc_api_key')):
            await interaction.followup.send(
                embed=err('Сначала настрой подключение к плагину: `/setup stats_plugin`'), ephemeral=True,
            )
            return
        rows = await _fetchall(
            self.bot,
            "SELECT DISTINCT minecraft_nick FROM whitelist_apps WHERE guild_id = ? "
            "AND status IN ('approved', 'completed')",
            (interaction.guild_id,),
        )
        done, failed = 0, 0
        for r in rows:
            success, _ = await _mc_whitelist_add(s, str(_row(r, 'minecraft_nick', '')))
            if success:
                done += 1
            else:
                failed += 1
            await asyncio.sleep(0.3)
        await interaction.followup.send(
            embed=ok(f'Синхронизация завершена: добавлено `{done}`, ошибок `{failed}`.'), ephemeral=True,
        )

    @wl.command(name='queue', description='Показать ники, ожидающие выдачи на Minecraft-сервере')
    async def queue(self, interaction: discord.Interaction):
        rows = await _fetchall(
            self.bot,
            'SELECT * FROM wl_mc_queue WHERE guild_id = ? ORDER BY id LIMIT 20', (interaction.guild_id,),
        )
        if not rows:
            await interaction.response.send_message(
                embed=ok('Очередь пуста — все одобренные ники выданы на сервере.'), ephemeral=True,
            )
            return
        lines = [
            f'• `{_row(r, "nick")}` — <@{_row(r, "user_id")}> (попыток: {_row(r, "attempts", 0)})'
            for r in rows
        ]
        await interaction.response.send_message(
            embed=warn('\n'.join(lines), title='⏳ Ожидают выдачи на сервере'), ephemeral=True,
        )


async def setup(bot):
    await bot.add_cog(Whitelist(bot))
