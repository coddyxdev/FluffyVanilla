"""
cogs/whitelist.py — Система белого списка Fluffy Vanilla.

Как это работает:
1. Админ отправляет кнопку «Подать заявку» в канал: /whitelist panel
2. Игрок жмёт кнопку → открывается анкета (модальное окно)
3. После отправки создаётся скрытый канал-заявка для админов (игрок его не видит)
4. Админ жмёт «Одобрить» или «Отклонить» (с указанием причины)
5. Игроку приходит решение в личные сообщения, ник добавляется в вайтлист MC
"""
import discord
from discord import app_commands
from discord.ext import commands, tasks
from datetime import datetime, timezone, timedelta
import logging
import re
import asyncio

from utils.audit import record_audit
from utils.emojis import MEMBER, VERIFIED, BAWWW, FLOWER, ADMIN_PINK, ARROW_PINK
from utils.embeds import (
    ok, err, warn, info, wl_app_embed, wl_info_embed,
    PINK, PINK_SOFT, SUCCESS, ERROR, CLOSED,
)

logger = logging.getLogger('FluFFy.Whitelist')

DENY_COOLDOWN_HOURS = 24     # сколько ждать после отказа перед новой заявкой
NEW_ACCOUNT_DAYS = 7         # аккаунт моложе N дней помечается как подозрительный
MAX_QUEUE_ATTEMPTS = 288     # 288 попыток × 5 мин = сутки ретраев
NICK_RE = re.compile(r'^[A-Za-z0-9_]{3,16}$')


# ═══════════════════════════ УТИЛИТЫ ════════════════════════════════════════

def _row(row, key, default=None):
    try:
        value = row[key]
        return default if value is None else value
    except Exception:
        return default


def _is_staff(member: discord.Member) -> bool:
    p = member.guild_permissions
    return p.manage_guild or p.administrator


async def _settings(bot, guild_id: int):
    s = await bot.db.get_guild(guild_id)
    if not s:
        await bot.db.ensure_guild(guild_id)
        s = await bot.db.get_guild(guild_id)
    return s


async def _fetchone(bot, sql: str, params=()):
    cur = await bot.db.db.execute(sql, params)
    row = await cur.fetchone()
    await cur.close()
    return row


async def _fetchall(bot, sql: str, params=()):
    cur = await bot.db.db.execute(sql, params)
    rows = await cur.fetchall()
    await cur.close()
    return rows


async def _exec(bot, sql: str, params=()):
    cur = await bot.db.db.execute(sql, params)
    await bot.db.db.commit()
    last_id = cur.lastrowid
    await cur.close()
    return last_id


async def _mojang_lookup(nick: str):
    """Проверяет ник через Mojang API. Возвращает (текст статуса, ссылка на скин)."""
    import aiohttp
    skin = 'https://mc-heads.net/body/' + nick
    url = 'https://api.mojang.com/users/profiles/minecraft/' + nick
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=5) as resp:
                if resp.status == 200:
                    return '✅ лицензия найдена', skin
                if resp.status in (204, 404):
                    return '⚠️ не найден в Mojang (пиратка?)', skin
                return f'❔ Mojang ответил {resp.status}', skin
    except Exception:
        return '❔ проверка недоступна', skin


async def _mc_whitelist_add(settings, nick: str):
    """Добавляет ник в вайтлист Minecraft через HTTP-плагин. Возвращает (ok, заметка)."""
    mc_host = _row(settings, 'mc_host')
    mc_port = _row(settings, 'mc_port')
    mc_key = _row(settings, 'mc_api_key')

    if not (mc_host and mc_port and mc_key and nick):
        return False, ''

    import aiohttp
    url = 'http://' + str(mc_host) + ':' + str(mc_port) + '/execute'
    headers = {'X-API-Key': mc_key, 'Content-Type': 'application/json'}
    data = f'whitelist add {nick}'
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(url, headers=headers, data=data, timeout=5.0) as resp:
                text = await resp.text()
        logger.info(f'HTTP Command: whitelist add {nick} -> {text}')
        return True, '\n✅ Ты уже добавлен в вайтлист игрового сервера!'
    except Exception as e:
        logger.error(f'Failed to reach MC HTTP API: {e}')
        return False, ('\n⏳ Сервер сейчас недоступен — бот добавит твой ник автоматически, '
                       'как только связь восстановится.')


async def _mc_whitelist_remove(settings, nick: str):
    """Удаляет ник из whitelist Minecraft через HTTP-мост."""
    mc_host = _row(settings, 'mc_host')
    mc_port = _row(settings, 'mc_port')
    mc_key = _row(settings, 'mc_api_key')

    if not (mc_host and mc_port and mc_key and nick):
        return False, 'Не найден Minecraft-ник или настройки API.'

    import aiohttp
    url = 'http://' + str(mc_host) + ':' + str(mc_port) + '/execute'
    headers = {'X-API-Key': mc_key, 'Content-Type': 'text/plain'}
    data = f'whitelist remove {nick}'
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(url, headers=headers, data=data, timeout=5.0) as resp:
                body = await resp.text()
                if not 200 <= resp.status < 300:
                    logger.error(f'HTTP Command failed: whitelist remove {nick} -> {resp.status} {body}')
                    return False, f'Minecraft API вернул HTTP {resp.status}.'
        logger.info(f'HTTP Command: whitelist remove {nick} -> {body}')
        return True, ''
    except Exception as e:
        logger.error(f'Failed to remove {nick} from MC whitelist: {e}')
        return False, 'Minecraft-сервер или API сейчас недоступен.'


async def _dm(user: discord.abc.User, embed: discord.Embed) -> bool:
    try:
        await user.send(embed=embed)
        return True
    except Exception:
        return False


