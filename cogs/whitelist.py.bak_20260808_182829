class WhitelistReviewView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @discord.ui.button(label='Одобрить', emoji=VERIFIED,
                       style=discord.ButtonStyle.success, custom_id='wl_review:approve')
    async def approve(self, interaction: discord.Interaction, button: discord.ui.Button):
        await _handle_review(interaction, True)

    @discord.ui.button(label='Отклонить', emoji=BAWWW,
                       style=discord.ButtonStyle.danger, custom_id='wl_review:deny')
    async def deny(self, interaction: discord.Interaction, button: discord.ui.Button):
        await _handle_review(interaction, False)


async def _get_app_by_channel(bot, channel_id: int):
    return await _fetchone(
        bot, 'SELECT * FROM whitelist_apps WHERE ticket_channel_id = ? ORDER BY id DESC LIMIT 1',
        (channel_id,),
    )


async def _handle_review(interaction: discord.Interaction, approved: bool):
    bot = interaction.client

    if not _is_staff(interaction.user):
        await interaction.response.send_message(
            embed=err('Заявки рассматривает только администрация.'), ephemeral=True,
        )
        return

    app = await _get_app_by_channel(bot, interaction.channel_id)
    if not app:
        await interaction.response.send_message(
            embed=err('Заявка не найдена в базе данных.'), ephemeral=True,
        )
        return

    if _row(app, 'status') != 'pending':
        await interaction.response.send_message(
            embed=info(f'Эта заявка уже обработана (статус: `{_row(app, "status")}`).'), ephemeral=True,
        )
        return


    if approved:
        await interaction.response.defer()
        await _finish_approve(interaction, app, interaction.user)
    else:
        await interaction.response.send_modal(DenyReasonModal(app))


class DenyReasonModal(discord.ui.Modal, title='Причина отказа'):
    reason = discord.ui.TextInput(
        label='Почему заявка отклонена?',
        placeholder='Игрок увидит этот текст в личных сообщениях',
        style=discord.TextStyle.paragraph,
        min_length=3, max_length=600, required=True,
    )

    def __init__(self, app):
        super().__init__()
        self.app = app

    async def on_submit(self, interaction: discord.Interaction):
        await interaction.response.defer()
        await _finish_deny(interaction, self.app, interaction.user, str(self.reason).strip())


async def _archive(bot, guild, app, decision_text: str, color: int, reviewer):
    """Сохраняет анкету и решение в канал-архив, чтобы ничего не терялось."""
    s = await _settings(bot, guild.id)
    log_id = _row(s, 'wl_logs_channel_id') or _row(s, 'wl_notify_channel_id')
    if not log_id:
        return
    channel = guild.get_channel(int(log_id))
    if not channel:
        return

    user_id = int(_row(app, 'user_id', 0))
    e = discord.Embed(
        title=f'Заявка #{_row(app, "id")} — {decision_text}',
        color=color,
        timestamp=datetime.now(timezone.utc),
    )
    e.add_field(name='Игрок', value=f'<@{user_id}> (`{user_id}`)', inline=True)
    e.add_field(name='Ник', value=str(_row(app, 'minecraft_nick', '—')), inline=True)
    e.add_field(name='Возраст', value=str(_row(app, 'age', '—')), inline=True)
    e.add_field(name='Почему хочет к нам', value=str(_row(app, 'join_reason', '—'))[:1024], inline=False)
    e.add_field(name='О себе', value=str(_row(app, 'about_me', '—'))[:1024], inline=False)
    e.add_field(name='Пригласил(а)', value=str(_row(app, 'invited_by', '—')), inline=True)
    e.add_field(name='Решение принял', value=reviewer.mention, inline=True)
    e.set_footer(text='Fluffy Vanilla • архив заявок')
    try:
        await channel.send(embed=e)
    except Exception:
        pass


async def _close_channel(interaction, delay: int = 5):
    try:
        await asyncio.sleep(delay)
        await interaction.channel.delete(reason='Whitelist application processed')
    except Exception:
        pass


async def _finish_approve(interaction, app, reviewer):
    bot = interaction.client
    guild = interaction.guild
    s = await _settings(bot, guild.id)
    user_id = int(_row(app, 'user_id', 0))
    nick = str(_row(app, 'minecraft_nick', ''))

    member = guild.get_member(user_id)
    role_note = ''
    role_id = _row(s, 'wl_role_id')
    if member and role_id:
        role = guild.get_role(int(role_id))
        if role:
            try:
                await member.add_roles(role, reason=f'Whitelist approved by {reviewer}')
            except discord.Forbidden:
                role_note = '\n⚠️ Боту не хватает прав, чтобы выдать роль белого списка.'
            except Exception as e:
                role_note = f'\n⚠️ Не удалось выдать роль: `{e}`'

    mc_ok, mc_note = await _mc_whitelist_add(s, nick)
    if not mc_ok and _row(s, 'mc_host') and _row(s, 'mc_api_key'):
        await _exec(
            bot,
            'INSERT INTO wl_mc_queue (guild_id, user_id, nick, attempts, created_at) VALUES (?, ?, ?, 0, ?)',
            (guild.id, user_id, nick, datetime.now(timezone.utc).isoformat()),
        )

    await _exec(
        bot,
        "UPDATE whitelist_apps SET status = 'completed', reviewed_by = ?, reviewed_at = ? WHERE id = ?",
        (reviewer.id, datetime.now(timezone.utc).isoformat(), _row(app, 'id')),
    )

    dm_sent = False
    if member:
        dm_sent = await _dm(member, discord.Embed(
            title='✅ Заявка одобрена!',
            description=(
                f'{VERIFIED} Привет, {member.mention}! Твоя заявка на **Fluffy Vanilla** одобрена 💚\n\n'
                f'**Твой ник:** `{nick}`\n'
                'Заходи на сервер и располагайся. Если что-то не работает — создай тикет.'
                + mc_note
            ),
            color=SUCCESS,
        ))

    await _archive(bot, guild, app, 'ОДОБРЕНА', SUCCESS, reviewer)

    warn_dm = '' if dm_sent else '\n⚠️ Не удалось отправить игроку ЛС (закрыты личные сообщения).'
    await interaction.followup.send(
        embed=ok(
            f'Заявка одобрена. Игрок <@{user_id}> (`{nick}`) добавлен в белый список.'
            f'{role_note}{warn_dm}\n\nКанал будет удалён через 5 секунд.'
        )
    )
    await record_audit(bot, guild.id, 'whitelist.approved', actor_id=reviewer.id, target_id=user_id, metadata={'app_id': _row(app, 'id'), 'nick': nick})
    logger.info(f'WL app #{_row(app, "id")} approved for {user_id} by {reviewer}')
    asyncio.create_task(_close_channel(interaction))


async def _finish_deny(interaction, app, reviewer, reason: str):
    bot = interaction.client
    guild = interaction.guild
    user_id = int(_row(app, 'user_id', 0))
    member = guild.get_member(user_id)

    await _exec(
        bot,
        "UPDATE whitelist_apps SET status = 'denied', reviewed_by = ?, reviewed_at = ? WHERE id = ?",
        (reviewer.id, datetime.now(timezone.utc).isoformat(), _row(app, 'id')),
    )

    dm_sent = False
    if member:
        dm_sent = await _dm(member, discord.Embed(
            title='❌ Заявка отклонена',
            description=(
                f'К сожалению, твоя заявка на **Fluffy Vanilla** отклонена.\n\n'
                f'**Причина:**\n>>> {reason}\n\n'
                f'Ты сможешь подать новую заявку через {DENY_COOLDOWN_HOURS} часа(ов) — '
                'просто нажми кнопку в канале с белым списком ещё раз.'
            ),
            color=ERROR,
        ))

    await _archive(bot, guild, app, f'ОТКЛОНЕНА — {reason[:200]}', ERROR, reviewer)

    warn_dm = '' if dm_sent else '\n⚠️ Не удалось отправить игроку ЛС (закрыты личные сообщения).'
    await interaction.followup.send(
        embed=err(
            f'Заявка отклонена.\n**Причина:** {reason}{warn_dm}\n\nКанал будет удалён через 5 секунд.',
            title='Заявка отклонена',
        )
    )
    await record_audit(bot, guild.id, 'whitelist.denied', actor_id=reviewer.id, target_id=user_id, reason=reason, metadata={'app_id': _row(app, 'id')})
    logger.info(f'WL app #{_row(app, "id")} denied for {user_id} by {reviewer}: {reason}')
    asyncio.create_task(_close_channel(interaction))


