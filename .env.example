# Скопируй файл в .env. Не коммить .env и не отправляй его содержимое другим.
DISCORD_TOKEN=
CLIENT_ID=

# 1 — быстро синхронизировать глобальные команды на каждом сервере при запуске.
# Для обычной работы оставь 0, чтобы не тратить rate limit Discord.
FAST_SYNC=0

# Основная конфигурация каналов, ролей и Minecraft API хранится в SQLite
# и задаётся slash-командами /setup.
